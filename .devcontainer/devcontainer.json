{
  "name": "GTA VI Clipper - mobiel dashboard",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.11-bookworm",
  "forwardPorts": [
    8765
  ],
  "portsAttributes": {
    "8765": {
      "label": "GTA Clipper mobiel dashboard",
      "onAutoForward": "notify",
      "visibility": "private",
      "protocol": "http"
    }
  },
  "postCreateCommand": "bash .devcontainer/setup.sh",
  "postStartCommand": "bash .devcontainer/start.sh",
  "postAttachCommand": "bash .devcontainer/start.sh",
  "customizations": {
    "vscode": {
      "settings": {
        "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python"
      },
      "extensions": [
        "ms-python.python"
      ]
    }
  }
}
